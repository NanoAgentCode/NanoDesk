{
  "name": "nano-desk",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:sync": "node scripts/sync-branding.mjs",
    "brand:check": "node scripts/sync-branding.mjs --check",
    "icons:build": "node scripts/render-brand-icons.mjs",
    "dev": "vite",
    "build": "npm run brand:check && tsc && vite build",
    "test": "npm run brand:check && vitest run",
    "install:nano": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-cli.ps1",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "package:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-all.ps1 -Fast",
    "package:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-frontend.ps1",
    "package:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-app.ps1",
    "package:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build/build-bundle.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@vitejs/plugin-react": "^4.3.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
