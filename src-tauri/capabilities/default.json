{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:app:allow-set-app-theme",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
