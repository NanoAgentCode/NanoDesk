{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoDesk",
  "version": "0.2.8",
  "identifier": "com.nanodesk.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NanoDesk",
        "decorations": false,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installerHooks": "document-chat-hooks.nsh" } },
    "icon": ["icons/icon.ico"]
  }
}
